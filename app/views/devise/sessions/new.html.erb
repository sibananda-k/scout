<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>SB Admin 2 - Login</title>

    <%= stylesheet_link_tag 'https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i', media: 'all' %>

</head>

<body class="bg-gradient-primary">
    <% if flash[:alert] || flash[:error] %>
    <div id="toast" class="toast show">
        <span><%= flash[:alert] || flash[:error] %></span>
    </div>
    <% end %>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block bg-login-image"></div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Welcome Back!</h1>
                                    </div>

                                    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "user" }) do |f| %>
                                    <div class="form-group">
                                        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Enter Email Address...", class: "form-control form-control-user" %>
                                    </div>
                                    <div class="form-group">
                                        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: "form-control form-control-user" %>
                                    </div>

                                    <% if devise_mapping.rememberable? %>
                                    <div class="form-group">
                                        <div class="custom-control custom-checkbox small">
                                            <%= f.check_box :remember_me, class: "custom-control-input", id: "customCheck" %>
                                            <%= f.label :remember_me, class: "custom-control-label", for: "customCheck" %>
                                        </div>
                                    </div>
                                    <% end %>

                                    <div class="form-group">
                                        <%= f.submit "Login", class: "btn btn-primary btn-user btn-block" %>
                                    </div>
                                    <% end %>
                                    <div class="text-center">
                                        <%= link_to "Forgot Password?", new_password_path(resource_name), class: "small" %>
                                    </div>
                                    <div class="text-center">
                                        <%= link_to "Create an Account!", new_registration_path(resource_name), class: "small" %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        let toast = document.getElementById("toast");
        if (toast) {
            toast.classList.add("show");
            setTimeout(() => {
                toast.classList.remove("show");
            }, 3000);
        }
    });
</script>