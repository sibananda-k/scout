<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Send Invitation</title>
    <!-- Custom fonts for this template -->
    <%= stylesheet_link_tag 'https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i', media: 'all' %>
</head>
<body class="bg-gradient-primary">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block bg-login-image"></div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Send an Invitation</h1>
                                    </div>
                                    <%= form_with url: send_invitation_path, local: true, html: { class: 'user' } do |form| %>
                                    <div class="form-group">
                                        <%= form.email_field :email, class: "form-control form-control-user", placeholder: "Email" %>
                                    </div>
                                    <div class="form-group">
                                        <%= form.text_field :name, class: "form-control form-control-user", placeholder: "Name" %>
                                    </div>
                                    <div class="form-group">
                                        <%= form.password_field :password, class: "form-control form-control-user", placeholder: "Password" %>
                                    </div>
                                    <div class="form-group" style="text-align: left; margin-left: 10px">
                                        <label class="text-gray-900">Role</label>
                                        <div class="form-check">
                                            <%= form.radio_button :role, "fullmember", class: "form-check-input" %>
                                            <%= form.label :role_fullmember, "Full Member", class: "form-check-label" %>
                                        </div>
                                        <div class="form-check">
                                            <%= form.radio_button :role, "limitedfullmember", class: "form-check-input" %>
                                            <%= form.label :role_limitedfullmember, "Limited Full Member", class: "form-check-label" %>
                                        </div>
                                        <div class="form-check">
                                            <%= form.radio_button :role, "admin", class: "form-check-input" %>
                                            <%= form.label :role_admin, "Admin", class: "form-check-label" %>
                                        </div>
                                        <div class="form-check">
                                            <%= form.radio_button :role, "readonly", class: "form-check-input" %>
                                            <%= form.label :role_readonly, "Read-Only", class: "form-check-label" %>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <%= form.submit "Send Invitation", class: "btn btn-primary btn-user btn-block" %>
                                    </div>
                                    <% end %>
                                    <div class="text-center">
                                        <%= link_to 'Back to Home', root_path, class: 'small' %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>